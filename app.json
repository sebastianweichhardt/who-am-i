{
  "expo": {
    "name": "Who Am I?",
    "slug": "who-am-i",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "whoami",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "requireFullScreen": true,
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Who Am I? to use motion so tilting your phone can mark guesses correct or passed."
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
